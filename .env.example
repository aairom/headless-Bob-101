# ──────────────────────────────────────────────────────────────────────────────
# Headless Bob Demo — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# The .env file is automatically loaded by the Streamlit application.
# ──────────────────────────────────────────────────────────────────────────────

# -----------------------------------------------------------------------------
# Headless Bob service connection
# -----------------------------------------------------------------------------

# Base URL of the running Headless Bob service.
# Default: http://127.0.0.1:8000 (local)
HEADLESS_BOB_URL=http://127.0.0.1:8000

# Bearer token to authenticate against the Headless Bob REST API.
# This must match one of the tokens defined in AUTH_TOKENS inside the
# Headless Bob service's own .env file.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HEADLESS_BOB_TOKEN=replace-with-your-service-token

# -----------------------------------------------------------------------------
# Headless Bob service configuration (used only if you run the service locally)
# The variables below are passed to the headlessbob service itself.
# See: https://github.com/ibm-self-serve-assets/building-blocks/tree/main/ai/ai-engineering/headless-bob
# -----------------------------------------------------------------------------

# IBM Bob Shell API key (Inference scope).
# Obtain from https://bob.ibm.com — Account → API Keys → Create key (Inference)
BOB_API_KEY=replace-with-your-bob-api-key

# Map of caller names to bearer tokens for the Headless Bob service.
# Each token should be at least 24 characters long.
# AUTH_TOKENS='{"owner":"replace-with-a-long-random-token"}'
